# Resend API key for contact form / newsletter
RESEND_API_KEY=

# Rate limiting for form POSTs. Set RATE_LIMIT_MAX=0 to disable (local dev).
#RATE_LIMIT_MAX=20
#RATE_LIMIT_WINDOW_MS=60000

# Posts demo data source. Point at fixture service in tests.
#POSTS_API_BASE=https://jsonplaceholder.typicode.com

# Email sender/recipient (used by Resend)
EMAIL_FROM=noreply@example.com
EMAIL_TO=contact@example.com

# Override default port (default: 3000)
PORT=3000

# Base URL for links (default: https://example.com)
# BASE_URL=https://example.com

# Static root directory (default: dist)
# STATIC_ROOT=dist

# PostgreSQL connection string (Bun.SQL). Required for migrations and
# any data-backed feature using App.Data.SQL. Format:
#   postgres://user:pass@host:5432/dbname
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
